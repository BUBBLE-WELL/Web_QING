{
  "_doc": "Layer groups for the viewer. Add a group or item here and drop its file under assets/; no code change needed for the types below. crs: 'project' = Archicad metres (placed via georef.json), 'wgs84' = lon/lat. Item types: glb-set (layers.json from build_assets.py), gltf (one GLB with its own materials, loaded on first show; the Twinmotion render export, see projects/UE/tools/README.md), line, point. Groups with no items are not shown.",
  "groups": [
    {
      "id": "massing",
      "label": "建筑体块白模",
      "on": true,
      "open": true,
      "items": [
        { "type": "glb-set", "source": "assets/layers.json", "lazy": ["other"] }
      ]
    },
    {
      "id": "render",
      "label": "规划 + 渲染（Twinmotion）",
      "on": false,
      "open": true,
      "attribution": "Twinmotion 场景导出，贴图为简化版；配景树木与人物未导出",
      "items": [
        { "id": "render-buildings", "type": "gltf", "label": "建筑、场地与水景（贴图）", "source": "assets/render/buildings.glb",
          "color": "#d9cba4", "size": "13 MB", "on": true },
        { "id": "render-furniture", "type": "gltf", "label": "景观设施", "source": "assets/render/furniture.glb",
          "color": "#a7a296", "size": "1.6 MB", "on": true },
        { "id": "render-planters", "type": "gltf", "label": "花池与植物", "source": "assets/render/planters.glb",
          "color": "#62893f", "size": "0.5 MB", "on": true },
        { "id": "render-terrain", "type": "gltf", "label": "周边地形", "source": "assets/render/terrain.glb",
          "color": "#8a6a4a", "size": "84 KB", "on": true }
      ]
    },
    {
      "id": "ref2d",
      "label": "2D 参考",
      "on": true,
      "open": true,
      "items": [
        { "id": "underlay", "type": "line", "label": "CAD 底图线", "source": "assets/underlay.geojson", "crs": "project",
          "filter": ["==", ["get", "kind"], "underlay"], "color": "#8f1f1f", "width": 1.6, "on": true },
        { "id": "footprint", "type": "line", "label": "楼板轮廓（2D）", "source": "assets/underlay.geojson", "crs": "project",
          "filter": ["==", ["get", "kind"], "footprint"], "color": "#d08a12", "width": 1.2, "on": false }
      ]
    },
    {
      "id": "final-plan",
      "label": "最终总平 · 0704",
      "on": false,
      "open": true,
      "attribution": "线稿不含文字、填充及图像；与三维体块分别显示",
      "items": [
        { "id": "final-floorplan", "type": "line", "label": "总平设计线稿", "source": "assets/final-floorplan-0704.geojson", "crs": "project",
          "filter": ["==", ["get", "kind"], "design"], "color": "#264f67", "width": 1.0, "on": true, "lazy": true },
        { "id": "final-context", "type": "line", "label": "周边测绘参考", "source": "assets/final-floorplan-0704.geojson", "crs": "project",
          "filter": ["==", ["get", "kind"], "context"], "color": "#7b8589", "width": 0.7, "on": false, "lazy": true },
        { "id": "final-detail", "type": "line", "label": "建筑细部线稿", "source": "assets/final-floorplan-0704.geojson", "crs": "project",
          "filter": ["==", ["get", "kind"], "detail"], "color": "#738a98", "width": 0.7, "on": false, "lazy": true }
      ]
    },
    {
      "id": "site",
      "label": "场地分析",
      "on": false,
      "open": false,
      "attribution": "场地分析 © OpenStreetMap contributors (ODbL)",
      "items": [
        { "id": "metro", "type": "point", "label": "地铁站出入口（小行站）", "source": "assets/site/metro_entrances.geojson", "crs": "wgs84",
          "color": "#2bb673", "label_field": "label", "short_field": "short", "on": true },
        { "id": "roads", "type": "line", "label": "道路", "source": "assets/site/roads.geojson", "crs": "wgs84",
          "color": "#8f7ae5", "width": 2.2, "on": true }
      ]
    },
    {
      "id": "policy",
      "label": "政策分析",
      "on": false,
      "open": false,
      "items": []
    }
  ]
}
